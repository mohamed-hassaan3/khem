# /srv/umami/.env — names only, never values. chmod 600, owner root.
#
# provision-umami.sh writes this file ONCE, generating every value with
# `openssl rand -hex 32`, and never overwrites it afterwards: regenerating
# APP_SECRET signs every user out, and a new POSTGRES_PASSWORD no longer
# matches the one the database volume was initialised with.
#
# Everything that is not a secret (endpoint, IP header, telemetry) is written
# in docker-compose.yml itself, where it is reviewed with the code.

POSTGRES_PASSWORD=
APP_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
