# /srv/khem/shared/.env.production — names only, never values.
# chmod 600, owner khem. `next start` reads it through the symlink deploy.sh
# places in each release. NEXT_PUBLIC_* values are inlined at BUILD time, so
# changing one needs a redeploy; any other value needs only `pm2 reload khem`.
# Full descriptions of every variable: .env.example at the repo root.

NODE_ENV=production

# Supabase (Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Clerk (production instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
ADMIN_EMAILS=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_ENABLED=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_HOUSE_FROM_EMAIL=
RESEND_ORDER_FROM_EMAIL=
EMAIL_ASSET_BASE_URL=
CONTACT_INBOX_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# Search embeddings (Vercel AI Gateway, cohere/embed-v4.0 — free tier)
AI_GATEWAY_API_KEY=

# Cron — same value as /srv/khem/shared/.cron.env
CRON_SECRET=

# Pre-launch cover (true = Coming Soon screen)
KHEM_PRELAUNCH=
KHEM_PRELAUNCH_VIDEO_URL=

# NOT here: SUPABASE_DB_URL / DIRECT_CONNECTION_STRING (scripts only, run from a
# workstation), VERCEL_* / VERCEL_OIDC_TOKEN and OPENAI_API_KEY (unused), ANTHROPIC_API_KEY (unused).
