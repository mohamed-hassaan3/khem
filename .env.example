# Copy to `.env.local` and fill in. Never commit `.env.local`.

# ── Clerk ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row level security, so it must never be renamed into a
# NEXT_PUBLIC_ variable or imported from a Client Component — see
# `src/lib/supabase.ts` and the trust model in
# `supabase/sql/product-comments.sql`.
#
# Optional: without it the product comments section renders nothing at all and
# the rest of the site is unaffected.
SUPABASE_SECRET_KEY=

# ── Admin dashboard ─────────────────────────────────────────
# Who may reach `/admin` and invoke its Server Actions. Comma-separated.
#
# Optional: defaults to khem.official@outlook.com, the house account. An empty
# or absent value means the default, never "nobody" and never "everybody".
#
# Checked server-side against the Clerk user's *verified* primary email, in
# `src/lib/admin/auth.ts`. It is not a secret — it grants nothing on its own —
# but it must not be renamed into a NEXT_PUBLIC_ variable, because the browser
# has no business knowing who the administrators are.
ADMIN_EMAILS=khem.official@outlook.com

# ── Vercel AI Gateway ───────────────────────────────────────
# Powers the semantic half of search: embeds the visitor's query at request
# time, and the catalog once, offline, via `npm run embed`.
#
# Optional. Without it the search silently falls back to lexical matching —
# it never breaks, it just stops understanding "smoky, for a winter night".
#
# On Vercel, prefer OIDC over this key: `vercel env pull` provides a token that
# rotates on its own. The SDK picks up whichever credential is present.
#
# Blank, like every value in this file. An example holds names, never secrets —
# which is what makes committing it safe, and `.gitignore`'s `!.env.example`
# deliberate rather than an oversight.
AI_GATEWAY_API_KEY=

# ── Resend ──────────────────────────────────────────────────
# Transactional email: the contact acknowledgement, the newsletter welcome, and
# every order message. Domain khemperfumes.com must stay verified in Resend.
#
# Optional. Without it nothing throws — each send logs a warning and returns.
# An order still saves and still appears on the dashboard; nobody is told about
# it by email, which is the honest failure rather than a silent one.
RESEND_API_KEY=

# Envelope sender for mail nobody answers (the house notification). Optional:
# defaults to "KHEM Website <noreply@khemperfumes.com>".
RESEND_FROM_EMAIL=

# Sender for mail a customer receives and may reply to. Optional: defaults to
# "KHEM <info@khemperfumes.com>". Must be on a domain Resend has verified.
RESEND_HOUSE_FROM_EMAIL=

# Where contact-form enquiries land. Optional: falls through to the
# "BoutiqueSetting" row and then to info@khemperfumes.com — the address the
# contact page publishes, which is what it has to agree with.
CONTACT_INBOX_EMAIL=

# Where new-order notifications land — the picking slip, with the address and
# phone number on it. Optional: defaults to khem.official@outlook.com.
#
# Deliberately separate from CONTACT_INBOX_EMAIL. Fulfilment and correspondence
# are different jobs and often different people; pointing one somewhere else
# must not silently move the other.
ORDER_NOTIFICATION_EMAIL=khem.official@outlook.com

# Absolute base for images inside emails. Optional: defaults to SITE_URL.
#
# Only a fallback path. The seal normally travels as an inline attachment (see
# `src/lib/email/logo.ts`), so it renders before the reader allows remote
# images. Override this to render mail against a preview deployment.
EMAIL_ASSET_BASE_URL=

# ── Stripe ──────────────────────────────────────────────────
# Card payments at /checkout. Test keys (pk_test_… / sk_test_…) work end to end
# against Stripe's test cards; going live is swapping these three for their live
# counterparts and nothing else.
#
# Optional, and it degrades honestly: with these absent the card option is
# hidden on the payment step and cash on delivery keeps working. Nothing is
# silently broken — an unconfigured key fails closed, never open.
#
# Orders are charged in EGP, the currency prices are stored and settled in. The
# six display currencies in `src/lib/currency.ts` never reach Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Signing secret for /api/webhooks/stripe. In development this comes from
#
#     stripe listen --forward-to localhost:3000/api/webhooks/stripe
#
# and in production from the endpoint's own secret in the Stripe dashboard.
#
# Without it the webhook answers 500 and no card order is ever promoted past
# PENDING. That is the correct failure: a webhook that accepted unsigned
# requests would let anyone mark any order paid.
STRIPE_WEBHOOK_SECRET=

# ── Cron ────────────────────────────────────────────────────
# Bearer token for /api/cron/sweep-unpaid-orders, which cancels and restocks
# card orders left unpaid for 30 minutes — the other half of reserving stock
# before payment. Vercel sends it automatically once the variable exists on the
# project. Any long random string; `openssl rand -hex 32` will do.
#
# The schedule in `vercel.json` is daily, because the Hobby plan permits at most
# one run per day and a more frequent expression makes Vercel refuse the whole
# deployment. Daily alone would be far too slow to free reserved stock, so the
# real sweep is opportunistic — `src/actions/checkout.ts` runs it before every
# order — and this cron is the backstop for a boutique that goes a day with no
# orders at all. On Pro, tighten it to `*/15 * * * *`.
#
# Without it the route refuses every request, including Vercel's, and abandoned
# baskets hold their stock until somebody cancels them by hand.
CRON_SECRET=
